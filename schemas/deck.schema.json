{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindcard.dev/schemas/deck.schema.json",
  "title": "MindCard Deck",
  "description": "A portable knowledge-card deck. Content is independent from the SRS engine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "chapters", "cards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "稳定且唯一的卡组 ID，用作存储键，发布后不要修改"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "subtitle": { "type": "string", "maxLength": 160 },
    "description": { "type": "string", "maxLength": 2000 },
    "language": { "type": "string", "default": "zh-CN" },
    "mode": {
      "enum": ["short", "long"],
      "description": "卡组生命周期：short=网页内可编辑；long=只读，需导出修改或另存为短期"
    },
    "author": { "type": "string", "maxLength": 120 },
    "license": { "type": "string", "maxLength": 200 },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 40 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["manual", "md", "txt", "docx", "pptx", "pdf", "xlsx", "url"] },
        "name": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 500 },
        "pages": { "type": "integer", "minimum": 1 }
      }
    },
    "legacyProgressKey": {
      "type": "string",
      "maxLength": 80,
      "description": "可选：旧版本使用的进度存储键，首次加载时迁移"
    },
    "targetCards": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999,
      "description": "可选：计划卡片数，仅用于编辑器进度展示"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^ch-[a-z0-9-]{1,48}$" },
          "order": { "type": "integer", "minimum": 0 },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "short": { "type": "string", "maxLength": 24 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/card" }
    },
    "extras": {
      "type": "object",
      "description": "卡组自带的可选扩展，如速查表；由 UI 决定是否展示",
      "additionalProperties": true
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chapter", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
        "chapter": { "type": "string", "pattern": "^ch-[a-z0-9-]{1,48}$" },
        "type": { "enum": ["recall", "cloze", "choice", "judge", "code"] },
        "tag": { "type": "string", "maxLength": 24 },
        "question": { "type": "string", "maxLength": 2000 },
        "answer": { "type": "string", "maxLength": 8000 },
        "questionImage": {
          "type": "string",
          "maxLength": 2000000,
          "pattern": "^data:image/(png|jpeg|webp|gif);base64,"
        },
        "answerImage": {
          "type": "string",
          "maxLength": 2000000,
          "pattern": "^data:image/(png|jpeg|webp|gif);base64,"
        },
        "hint": { "type": "string", "maxLength": 500 },
        "explanation": { "type": "string", "maxLength": 4000 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "url": { "type": "string", "maxLength": 500 },
            "quote": { "type": "string", "maxLength": 1000 }
          }
        },
        "accept": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "answerIndex": { "type": "integer", "minimum": 0 },
        "correct": { "type": "boolean" },
        "pre": { "type": "string", "maxLength": 8000 }
      },
      "allOf": [
        {
          "anyOf": [
            { "required": ["question"], "properties": { "question": { "minLength": 1 } } },
            { "required": ["questionImage"] }
          ]
        },
        {
          "anyOf": [
            { "required": ["answer"], "properties": { "answer": { "minLength": 1 } } },
            { "required": ["answerImage"] }
          ]
        },
        {
          "if": { "properties": { "type": { "const": "choice" } }, "required": ["type"] },
          "then": { "required": ["options", "answerIndex"] }
        },
        {
          "if": { "properties": { "type": { "const": "judge" } }, "required": ["type"] },
          "then": { "required": ["correct"] }
        },
        {
          "if": { "properties": { "type": { "const": "cloze" } }, "required": ["type"] },
          "then": { "required": ["accept"], "properties": { "accept": { "minItems": 1 } } }
        }
      ]
    }
  }
}
